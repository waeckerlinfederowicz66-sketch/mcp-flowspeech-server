{
  "name": "mcp-flowspeech-server",
  "version": "0.2.0",
  "description": "MCP server for the FlowSpeech public API with asynchronous speech jobs, voice discovery and quota checks",
  "keywords": [
    "mcp",
    "mcp-server",
    "text-to-speech",
    "tts",
    "flowspeech",
    "ai",
    "voice",
    "speech-synthesis"
  ],
  "homepage": "https://flowspeech.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waeckerlinfederowicz66-sketch/mcp-flowspeech-server.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-flowspeech-server": "dist/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "SKILL.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:packed": "npm run build && node scripts/test-packed.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm test && npm run test:packed"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.3"
  }
}
